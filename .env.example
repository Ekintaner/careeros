# Docker Compose only. ASP.NET reads environment variables or user-secrets, not this file.
POSTGRES_DB=careeros
POSTGRES_USER=careeros
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
REDIS_PORT=6379

# ASP.NET configuration placeholders: .env is not loaded by the API automatically.
# Set through environment variables or a secret manager/user-secrets.
Auth__Issuer=careeros
Auth__Audience=careeros-web
Auth__SigningKey=<base64-encoded-random-key-at-least-32-bytes>
Auth__AccessTokenMinutes=5
Auth__RefreshTokenDays=30
Auth__DevelopmentCapture=false
Cors__AllowedOrigins__0=https://your-frontend.example
# Proxy__KnownProxies__0=<trusted-edge-IP-that-overwrites-forwarded-headers>
# Next.js server-only configuration goes in apps/web/.env.local:
# API_INTERNAL_URL=http://localhost:5080

# API optional settings: set in process environment/user-secrets, not Compose .env.
# ConnectionStrings__PostgreSql=Host=localhost;Port=5432;Database=careeros;Username=careeros;Password=<private-password>
# ConnectionStrings__Redis=localhost:6379
# Documents__StorageRoot=<absolute-private-directory-outside-repository-and-web-root>
# AllowedHosts=localhost;127.0.0.1
# Local development CORS origin: http://localhost:3000
# LocalAi__Enabled=false
# LocalAi__Model=
